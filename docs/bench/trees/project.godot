; Engine configuration file.
config_version=5

[application]

config/name="Tree generator bench"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[rendering]

; Soft shadow filtering without TAA: single raster captures, no dithered penumbras.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
pathtracing/async_shader_compilation=false

[physics]

3d/physics_engine="PhysX"
