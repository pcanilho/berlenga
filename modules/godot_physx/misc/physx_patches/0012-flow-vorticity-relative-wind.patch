diff --git a/flow/include/nvflow/NvFlow.h b/flow/include/nvflow/NvFlow.h
index 4173166..d36d13f 100644
--- a/flow/include/nvflow/NvFlow.h
+++ b/flow/include/nvflow/NvFlow.h
@@ -993,8 +993,12 @@ typedef struct NvFlowVorticityParams
     float fuelMask;
     float burnMask;
     float smokeMask;
+    NvFlowFloat3 ambientVelocity;
 }NvFlowVorticityParams;
 
+// ambientVelocity is there (an added field, not in NVIDIA's release).
+#define NV_FLOW_VORTICITY_AMBIENT_VELOCITY 1
+
 #define NvFlowVorticityParams_default_init { \
     NV_FLOW_TRUE, /*enabled*/ \
     0.6f,    /*forceScale*/ \
@@ -1006,7 +1010,8 @@ typedef struct NvFlowVorticityParams
     0.f,    /*temperatureMask*/ \
     0.f,    /*fuelMask*/ \
     0.f,    /*burnMask*/ \
-    0.f        /*smokeMask*/ \
+    0.f,        /*smokeMask*/ \
+    {0.f, 0.f, 0.f}    /*ambientVelocity*/ \
 }
 static const NvFlowVorticityParams NvFlowVorticityParams_default = NvFlowVorticityParams_default_init;
 
@@ -1023,6 +1028,7 @@ NV_FLOW_REFLECT_VALUE(float, temperatureMask, 0, 0)
 NV_FLOW_REFLECT_VALUE(float, fuelMask, 0, 0)
 NV_FLOW_REFLECT_VALUE(float, burnMask, 0, 0)
 NV_FLOW_REFLECT_VALUE(float, smokeMask, 0, 0)
+NV_FLOW_REFLECT_VALUE(NvFlowFloat3, ambientVelocity, 0, 0)
 NV_FLOW_REFLECT_END(&NvFlowVorticityParams_default)
 #undef NV_FLOW_REFLECT_TYPE
 
