diff --git a/flow/source/nvflow/shaders/Vorticity2CS.hlsl b/flow/source/nvflow/shaders/Vorticity2CS.hlsl
index bc1ee51..7b460bb 100644
--- a/flow/source/nvflow/shaders/Vorticity2CS.hlsl
+++ b/flow/source/nvflow/shaders/Vorticity2CS.hlsl
@@ -94,6 +94,10 @@ void main(uint3 dispatchThreadID : SV_DispatchThreadID, uint3 groupID : SV_Group
 
         velocityLowpass *= (1.f / 7.f);
 
+        // The speed relative to the ambient air (the weather wind the gas is carried on): the confinement
+        // follows the gas's own motion, not the frame it is seen from (Galilean invariant).
+        velocityLowpass.xyz -= float3(layerParamsIn[layerParamIdx].ambientVelocityX, layerParamsIn[layerParamIdx].ambientVelocityY, layerParamsIn[layerParamIdx].ambientVelocityZ);
+
         velocityLowpass.w = length(velocityLowpass.xyz);
         speed = velocityLowpass.w;
         speedLog = speed;
